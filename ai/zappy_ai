#!/usr/bin/env python3

import sys
import argparse
from network.client import Client
from logic.brain import Brain


def parse_args():
    parser = argparse.ArgumentParser(prog="zappy_ai", add_help=False)
    # port du serveur — obligatoire
    parser.add_argument("-p", type=int, required=True, dest="port")
    # nom de l'équipe — obligatoire
    parser.add_argument("-n", type=str, required=True, dest="name")
    # adresse du serveur — localhost par défaut
    parser.add_argument("-h", type=str, default="localhost", dest="host")
    return parser.parse_args()


def main():
    args = parse_args()
    # on crée le client et on fait le handshake avec le serveur
    client = Client(args.host, args.port, args.name)
    client.connect()
    # on lance la boucle de décision
    brain = Brain(client)
    brain.run()


if __name__ == "__main__":
    main()
