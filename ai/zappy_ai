#!/usr/bin/env python3

import sys
import argparse
from src.client import Client
from src.brain import Brain


def parse_args():
    parser = argparse.ArgumentParser(prog="zappy_ai")
    parser.add_argument("-p", type=int, required=True, dest="port", help="port number")
    parser.add_argument("-n", type=str, required=True, dest="name", help="team name")
    parser.add_argument("-h", type=str, default="localhost", dest="host", help="machine hostname")
    return parser.parse_args()


def main():
    args = parse_args()
    client = Client(args.host, args.port, args.name)
    client.connect()
    brain = Brain(client)
    brain.run()


if __name__ == "__main__":
    main()
