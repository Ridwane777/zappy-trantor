#!/usr/bin/env python3
"""zappy_ai: drives one player. The first process of a team becomes the queen and
starts its teammates; the processes it starts become workers (see logic/pack.py)."""
import argparse
import os
import sys

from comm.jammer import Jammer

from comm.secure import make_channel
from logic.pack import PackQueen, PackWorker
from logic.team import ProcessSpawner, Recruiter, is_child_process
from network.client import Client, ServerClosed
from network.game_api import GameApi


def parse_args():
    parser = argparse.ArgumentParser(prog="zappy_ai", add_help=False,
                                     usage="zappy_ai -p port -n name [-h machine]")
    parser.add_argument("-p", type=int, required=True, dest="port", help="port number")
    parser.add_argument("-n", required=True, dest="name", help="name of the team")
    parser.add_argument("-h", default="localhost", dest="host", help="name of the machine (default localhost)")
    parser.add_argument("-help", "--help", action="help", help="show this help and exit")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    client = Client(args.host, args.port, args.name)
    try:
        client.connect()
        api = GameApi(client)
        channel = make_channel(args.name)
        if is_child_process():
            PackWorker(api, channel).run()
        else:
            recruiter = Recruiter(api, ProcessSpawner(args.host, args.port, args.name))
            # ZAPPY_JAM=0 turns the attack off (control runs of the benchmark).
            jammer = Jammer(enabled=os.getenv("ZAPPY_JAM") != "0")
            PackQueen(api, channel, recruiter, jammer).run()
    except (ServerClosed, BrokenPipeError, ConnectionResetError):
        return 0   # game over, death, or server shutdown
    except ConnectionRefusedError:
        print(f"zappy_ai: no server on {args.host}:{args.port}", file=sys.stderr)
        return 84
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
